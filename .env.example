# Copie ce fichier en ".env" et colle tes clés. Le fichier .env est ignoré par Git :
# il ne sera jamais publié. Ne mets JAMAIS une vraie clé dans ce fichier-ci.

# Claude (écriture du script) : https://console.anthropic.com
ANTHROPIC_API_KEY=

# ElevenLabs (voix off, alignement, musique) : https://elevenlabs.io
ELEVENLABS_API_KEY=

# fal.ai (Kling 3.0 / Veo 3.1) : https://fal.ai/dashboard/keys
FAL_KEY=

# --- Optionnel ---
# ELEVENLABS_VOICE_ID=          # toujours la même voix (identité de la chaîne)
# VIDEO_MODEL=kling             # kling | veo | veo-fast
# BUDGET_MAX_USD=10             # plafond de dépense vidéo par vidéo
# CLAUDE_MODEL=claude-sonnet-5-5
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_MUSIC_MODEL=music_v2_5
# SUB_FONT=Oswald               # police installée sur la machine
